    "financialSectors": ["Financials", "Real Estate"],
    "fundamentals": {
      "minFrameCoverage": 0.5,
      "metrics": [
        { "key": "revenue", "unit": "USD", "kind": "duration", "offsets": [0, 1, 3], "chain": ["Revenues", "RevenueFromContractWithCustomerExcludingAssessedTax", "RevenueFromContractWithCustomerIncludingAssessedTax", "SalesRevenueNet"] },
        { "key": "netIncome", "unit": "USD", "kind": "duration", "offsets": [0, 1, 2], "chain": ["NetIncomeLoss", "ProfitLoss"] },
        { "key": "eps", "unit": "USD-per-shares", "kind": "duration", "offsets": [0, 1], "chain": ["EarningsPerShareDiluted", "EarningsPerShareBasicAndDiluted", "EarningsPerShareBasic"] },
        { "key": "grossProfit", "unit": "USD", "kind": "duration", "offsets": [0], "chain": ["GrossProfit"] },
        { "key": "opIncome", "unit": "USD", "kind": "duration", "offsets": [0], "chain": ["OperatingIncomeLoss"] },
        { "key": "opCashFlow", "unit": "USD", "kind": "duration", "offsets": [0], "chain": ["NetCashProvidedByUsedInOperatingActivities", "NetCashProvidedByUsedInOperatingActivitiesContinuingOperations"] },
        { "key": "capex", "unit": "USD", "kind": "duration", "offsets": [0], "chain": ["PaymentsToAcquirePropertyPlantAndEquipment", "PaymentsToAcquireProductiveAssets", "PaymentsForCapitalImprovements"] },
        { "key": "dps", "unit": "USD-per-shares", "kind": "duration", "offsets": [0], "chain": ["CommonStockDividendsPerShareDeclared", "CommonStockDividendsPerShareCashPaid"] },
        { "key": "equity", "unit": "USD", "kind": "instant", "offsets": [0], "chain": ["StockholdersEquity", "StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest"] },
        { "key": "assets", "unit": "USD", "kind": "instant", "offsets": [0], "chain": ["Assets"] },
        { "key": "liabilities", "unit": "USD", "kind": "instant", "offsets": [0], "chain": ["Liabilities"] }
      ],
      "shares": {
        "instantQuarters": 3,
        "instantTaxonomy": "dei",
        "instantConcept": "EntityCommonStockSharesOutstanding",
        "fallbackConcept": "WeightedAverageNumberOfDilutedSharesOutstanding",
        "fallbackKind": "duration"
      }
