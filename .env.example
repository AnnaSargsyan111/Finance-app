# Copy to .env.local (git-ignored) and fill in. Nothing here is a real secret.
# All variables are server-side only. There are intentionally NO public (browser-exposed) variables.

# --- Database -------------------------------------------------------------
# Leave empty for local development: an embedded PGlite database is created in ./.data/pglite
# Production: Neon pooled connection string, e.g. postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
# Other accepted forms: pglite:./.data/pglite  |  pglite:memory
DATABASE_URL=

# --- Auth (Better Auth) ---------------------------------------------------
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Public base URL of the deployed app (used for reset links and the CSRF origin check)
APP_BASE_URL=http://localhost:3000
# Extra allowed origins for state-changing requests, comma separated (e.g. preview deployments)
TRUSTED_ORIGINS=
# Reset link template sent by email; {token} is replaced. Default: ${APP_BASE_URL}/auth?mode=reset&token={token}
PASSWORD_RESET_URL=

# --- Email (Resend) - optional in dev: without it, emails are printed to the server console ------
RESEND_API_KEY=
EMAIL_FROM=

# --- Polite HTTP identity -------------------------------------------------
# Descriptive User-Agent for CBA / RSS / Yahoo / GitHub requests. Do not put secrets here.
HTTP_USER_AGENT=FinanceAppPrototype/0.1 (educational project)
# SEC EDGAR REQUIRES a real contact: "AppName contact@your-domain". Not hard-coded anywhere; EDGAR calls are refused when unset.
SEC_USER_AGENT=

# --- Market data providers (keys are optional; without them the keyed adapters report notConfigured) ----
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
# auto    = use keyed providers when a key exists, otherwise report notConfigured (real fallbacks still work)
# fixture = keyed providers answer from recorded fixtures and every response says isFixture:true
KEYED_PROVIDER_MODE=auto
# Yahoo endpoints are unofficial and ToS-restricted: prototype-only fallback. Set false to disable.
ALLOW_YAHOO_PROTOTYPE=true

# --- Jobs -----------------------------------------------------------------
# Bearer secret protecting /api/jobs/<name> (GET for Vercel Cron - fx/news/stocks only; POST for GitHub Actions /
# manual triggers, including universe). Vercel attaches this automatically to Cron requests once it is set as a
# Vercel project env var - see DEPLOYMENT.md. Jobs are refused (403) when this is empty.
CRON_SECRET=
# Dev only: limit the nightly universe batch to the first N constituents
UNIVERSE_LIMIT=
# Set true to refuse all outbound HTTP (offline testing)
OFFLINE=false
